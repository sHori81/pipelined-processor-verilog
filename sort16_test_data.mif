DEPTH = 4096;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- ==================================================
-- 【データ領域】 (DMEM 0000番地スタート)
-- 合計値: 1 + 2 + 3 + 4 + 5 + 6 + 7 + 8 = 36 (0x0024)
-- ==================================================
0000 : 0001;
0001 : 0002;
0002 : 0003;
0003 : 0004;
0004 : 0005;
0005 : 0006;
0006 : 0007;
0007 : 0008;

[0008..0FFF] : 0000;
END;