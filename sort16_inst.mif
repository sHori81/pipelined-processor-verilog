DEPTH = 4096;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- 【初期化】
0000 : 8000; -- LI R0, 0
0001 : 8101; -- LI R1, 1        (判定用マスク)

-- 【アウター・ループ（16周）】
0002 : 9900; -- CMPI R1, 0      (符号ビット周回か判定)
0003 : 0000; -- NOP             (★条件1: CMPIの後)
0004 : B902; -- BLT +2          (0x8000なら IS_SIGN(0007) へ)
0005 : 8700; -- LI R7, 0        (R7 = 0: 通常ビット)
0006 : A001; -- B +1            (INIT_PTR(0008) へ)
0007 : 8701; -- LI R7, 1        (R7 = 1: 符号ビット)

-- (ポインタ初期化)
0008 : 8200; -- LI R2, 0        (R2 = i = 0x00)
0009 : 8310; -- LI R3, 16       (R3 = head0 = 0x10)
000A : 8420; -- LI R4, 32       (R4 = head1 = 0x20)

-- 【インナー・ループ：配列の振り分け】
000B : 0000; -- NOP             (★追加: 000Bの前のNOP)
000C : 2A00; -- LD R5, 0(R2)
000D : 0000; -- NOP             (★条件3: LDの後、R5を使用するため)
000E : EE60; -- MOV R6, R5
000F : CE20; -- AND R6, R1
0010 : 9E00; -- CMPI R6, 0      
0011 : 0000; -- NOP             (★条件1: CMPIの後)
0012 : BB04; -- BNE +4          (1なら IS_ONE(0017) へ ※オフセット修正)

-- (IS_ZERO)
0013 : 9F00; -- CMPI R7, 0      (符号ビット周期か？)
0014 : 0000; -- NOP             (★条件1: CMPIの後)
0015 : B804; -- BE +4           (通常なら 0バッファへ ※オフセット修正)
0016 : A006; -- B +6            (符号なら反転して 1バッファへ ※オフセット修正)

-- (IS_ONE)
0017 : 9F01; -- CMPI R7, 1      (符号ビット周期か？)
0018 : 0000; -- NOP             (★条件1: CMPIの後)
0019 : BB03; -- BNE +3          (通常なら 1バッファへ。符号なら0バッファへ)

-- (PUT_HEAD0)
001A : 6B00; -- ST R5, 0(R3)
001B : 8B01; -- ADDI R3, 1
001C : A002; -- B +2            (NEXT_ELEM(001F) へ)

-- (PUT_HEAD1)
001D : 6C00; -- ST R5, 0(R4)
001E : 8C01; -- ADDI R4, 1

-- (NEXT_ELEM: 16個の終了判定 0x0010)
001F : 8A01; -- ADDI R2, 1
0020 : 9A10; -- CMPI R2, 16     (i == 16 に達したか？)
0021 : 0000; -- NOP             (★条件1: CMPIの後)
0022 : BBE9; -- BNE -23         (終わってなければ インナーループ先頭 000C へ戻る ※オフセット修正)

-- 【配列の書き戻しフェーズ】
0023 : 8200; -- LI R2, 0        (R2 = dst = 0x00)
0024 : 8610; -- LI R6, 16       (R6 = src0 = 0x10)

-- (0バッファの書き戻し)
0025 : DE50; -- CMP R6, R3      (R3: 0バッファの終わり)
0026 : 0000; -- NOP             (★条件1: CMPの後)
0027 : B806; -- BE +6           (達したら COPY1_INIT(002E) へ ※オフセット修正)
0028 : 2E00; -- LD R5, 0(R6)
0029 : 0000; -- NOP             (★条件3: LDの後、R5をSTで使用するため)
002A : 6A00; -- ST R5, 0(R2)
002B : 8E01; -- ADDI R6, 1
002C : 8A01; -- ADDI R2, 1
002D : A0F7; -- B -9            (0025 へ戻る ※オフセット修正)

-- (1バッファの書き戻し)
002E : 8620; -- LI R6, 32       (R6 = src1 = 0x20)
002F : E650; -- CMP R6, R4      (R4: 1バッファの終わり)
0030 : 0000; -- NOP             (★条件1: CMPの後)
0031 : B806; -- BE +6           (達したら END_OUTER(0038) へ ※オフセット修正)
0032 : 2E00; -- LD R5, 0(R6)
0033 : 0000; -- NOP             (★条件3: LDの後、R5をSTで使用するため)
0034 : 6A00; -- ST R5, 0(R2)
0035 : 8E01; -- ADDI R6, 1
0036 : 8A01; -- ADDI R2, 1
0037 : A0F7; -- B -9            (002F へ戻る ※オフセット修正)

-- 【アウター・ループ終了判定】
0038 : C181; -- SLL R1, 1
0039 : 0000; -- NOP             (★条件2: シフト命令の後)
003A : 9900; -- CMPI R1, 0      (16ビット回ったか？)
003B : 0000; -- NOP             (★条件1: CMPIの後)
003C : BBC5; -- BNE -59         (終わってなければ アウター先頭 0002 へ戻る ※オフセット修正)

-- 完了停止
003D : B7FF; -- LUI R7, 0xFF    (R7 = FFFF)
003E : A7FF; -- B -1

[003F..0FFF] : 0000;
END;