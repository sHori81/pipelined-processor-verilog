DEPTH = 4096;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- ソート対象の16個のランダムな符号付き整数
0000 : 3A9F; -- ( 15007)
0001 : F21A; -- (-3558)
0002 : 0000; -- (     0)
0003 : 8000; -- (-32768) 最小値
0004 : 7FFF; -- ( 32767) 最大値
0005 : FFFF; -- (    -1)
0006 : 01B4; -- (   436)
0007 : ABCD; -- (-21555)
0008 : 4321; -- ( 17185)
0009 : F000; -- (-4096)
000A : 1234; -- (  4660)
000B : 9999; -- (-26215)
000C : 7777; -- ( 30583)
000D : EEEF; -- (-4369)
000E : 0005; -- (     5)
000F : 8001; -- (-32767)

-- 一時バッファ等
[0010..0FFF] : 0000;
END;