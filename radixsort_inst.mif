DEPTH = 16384;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- 【初期化】
0000 : 8000; -- LI R0, 0
0001 : 8101; -- LI R1, 1        (判定用マスク)

-- 【アウター・ループ（16周）】
0002 : 9900; -- CMPI R1, 0      (符号ビット周回か判定)
0003 : 0000; -- NOP             (★条件1: CMPIの後)
0004 : B902; -- BLT +2          (0x8000なら IS_SIGN(0007) へ)
0005 : 8700; -- LI R7, 0        (R7 = 0: 通常ビット)
0006 : A001; -- B +1            (INIT_PTR(0008) へ)
0007 : 8701; -- LI R7, 1        (R7 = 1: 符号ビット)

-- (ポインタ初期化: 1024個用のアドレスへ変更)
0008 : B204; -- LUI R2, 0x04    (R2 = src = 0x0400)
0009 : B308; -- LUI R3, 0x08    (R3 = head0 = 0x0800)
000A : B40C; -- LUI R4, 0x0C    (R4 = head1 = 0x0C00)

-- 【インナー・ループ：配列の振り分け】
000B : 0000; -- NOP             (★追加: 000Bの前のNOP)
000C : 2A00; -- LD R5, 0(R2)
000D : 0000; -- NOP             (★条件3: LDの後、R5を使用するため)
000E : EE60; -- MOV R6, R5
000F : CE20; -- AND R6, R1
0010 : 9E00; -- CMPI R6, 0      
0011 : 0000; -- NOP             (★条件1: CMPIの後)
0012 : BB04; -- BNE +4          (1なら IS_ONE(0017) へ)

-- (IS_ZERO)
0013 : 9F00; -- CMPI R7, 0      (符号ビット周期か？)
0014 : 0000; -- NOP             (★条件1: CMPIの後)
0015 : B804; -- BE +4           (通常なら 0バッファへ)
0016 : A006; -- B +6            (符号なら反転して 1バッファへ)

-- (IS_ONE)
0017 : 9F01; -- CMPI R7, 1      (符号ビット周期か？)
0018 : 0000; -- NOP             (★条件1: CMPIの後)
0019 : BB03; -- BNE +3          (通常なら 1バッファへ。符号なら0バッファへ)

-- (PUT_HEAD0)
001A : 6B00; -- ST R5, 0(R3)
001B : 8B01; -- ADDI R3, 1
001C : A002; -- B +2            (NEXT_ELEM(001F) へ)

-- (PUT_HEAD1)
001D : 6C00; -- ST R5, 0(R4)
001E : 8C01; -- ADDI R4, 1

-- (NEXT_ELEM: 1024個の終了判定 0x0800に達したか)
001F : 8A01; -- ADDI R2, 1
0020 : B608; -- LUI R6, 0x08    (終了境界アドレス 0x0800)
0021 : 0000; -- NOP
0022 : F250; -- CMP R2, R6      (i == 0x0800 に達したか？)
0023 : 0000; -- NOP             (★条件1: CMPの後)
0024 : BBE7; -- BNE -25         (終わってなければ インナーループ先頭 000C へ戻る ※オフセット再計算済)

-- 【配列の書き戻しフェーズ】
0025 : B204; -- LUI R2, 0x04    (R2 = dst = 0x0400)
0026 : B608; -- LUI R6, 0x08    (R6 = src0 = 0x0800)

-- (0バッファの書き戻し)
0027 : DE50; -- CMP R6, R3      (R3: 0バッファの終わり)
0028 : 0000; -- NOP             (★条件1: CMPの後)
0029 : B806; -- BE +6           (達したら COPY1_INIT(0030) へ)
002A : 2E00; -- LD R5, 0(R6)
002B : 0000; -- NOP             (★条件3: LDの後、R5をSTで使用するため)
002C : 6A00; -- ST R5, 0(R2)
002D : 8E01; -- ADDI R6, 1
002E : 8A01; -- ADDI R2, 1
002F : A0F7; -- B -9            (0027 へ戻る)

-- (1バッファの書き戻し)
0030 : B60C; -- LUI R6, 0x0C    (R6 = src1 = 0x0C00)
0031 : E650; -- CMP R6, R4      (R4: 1バッファの終わり)
0032 : 0000; -- NOP             (★条件1: CMPの後)
0033 : B806; -- BE +6           (達したら END_OUTER(003A) へ)
0034 : 2E00; -- LD R5, 0(R6)
0035 : 0000; -- NOP             (★条件3: LDの後、R5をSTで使用するため)
0036 : 6A00; -- ST R5, 0(R2)
0037 : 8E01; -- ADDI R6, 1
0038 : 8A01; -- ADDI R2, 1
0039 : A0F7; -- B -9            (0031 へ戻る)

-- 【アウター・ループ終了判定】
003A : C181; -- SLL R1, 1
003B : 0000; -- NOP             (★条件2: シフト命令の後)
003C : 9900; -- CMPI R1, 0      (16ビット回ったか？)
003D : 0000; -- NOP             (★条件1: CMPIの後)
003E : BBC3; -- BNE -61         (終わってなければ アウター先頭 0002 へ戻る ※オフセット再計算済)

-- 完了停止
003F : C0F0; -- HLT             (ソート完了、ハードウェアカウンタ停止)
0040 : A7FF; -- B -1            (安全のための無限ループ)

[0041..3FFF] : 0000;
END;
