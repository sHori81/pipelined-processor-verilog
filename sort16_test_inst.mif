DEPTH = 4096;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- 【初期化】
0000 : 8000; -- LI R0, 0    (R0 = 0)
0001 : 8101; -- LI R1, 1    (R1 = 1)

-- ==================================================
-- 【テスト1】BE (Equal) : 分岐するはず
-- ==================================================
0002 : 9901; -- CMPI R1, 1  (R1 == 1 なので Z=1)
0003 : 0000; -- NOP         (★条件1: CMPIの後)
0004 : B801; -- BE +1       (成立して 0006 へ飛ぶ ※d=0006-0004-1)
0005 : A02A; -- B +42       (※誤ってここを実行したら ERROR(0030) へ ※d=0030-0005-1)

-- ==================================================
-- 【テスト2】BE (Equal) : 分岐しないはず
-- ==================================================
0006 : 9900; -- CMPI R1, 0  (R1 != 0 なので Z=0)
0007 : 0000; -- NOP         (★条件1: CMPIの後)
0008 : B827; -- BE +39      (誤って成立したら ERROR(0030) へ飛ぶ ※d=0030-0008-1)

-- ==================================================
-- 【テスト3】BNE (Not Equal) : 分岐するはず
-- ==================================================
0009 : 9900; -- CMPI R1, 0  (R1 != 0 なので Z=0)
000A : 0000; -- NOP         (★条件1: CMPIの後)
000B : BB01; -- BNE +1      (成立して 000D へ飛ぶ)
000C : A023; -- B +35       (※誤ってここを実行したら ERROR(0030) へ)

-- ==================================================
-- 【テスト4】BNE (Not Equal) : 分岐しないはず
-- ==================================================
000D : 9901; -- CMPI R1, 1  (R1 == 1 なので Z=1)
000E : 0000; -- NOP         (★条件1: CMPIの後)
000F : BB20; -- BNE +32     (誤って成立したら ERROR(0030) へ飛ぶ)

-- ==================================================
-- 【テスト5】BLT (Less Than) : 分岐するはず (0 < 1)
-- ==================================================
0010 : 9801; -- CMPI R0, 1  (R0 < 1 なので S^V=1)
0011 : 0000; -- NOP         (★条件1: CMPIの後)
0012 : B901; -- BLT +1      (成立して 0014 へ飛ぶ)
0013 : A01C; -- B +28       (※誤ってここを実行したら ERROR(0030) へ)

-- ==================================================
-- 【テスト6】BLT (Less Than) : 分岐しないはず (1 < 0 は偽)
-- ==================================================
0014 : 9900; -- CMPI R1, 0  (R1 > 0 なので S^V=0)
0015 : 0000; -- NOP         (★条件1: CMPIの後)
0016 : B919; -- BLT +25     (誤って成立したら ERROR(0030) へ飛ぶ)

-- ==================================================
-- 【テスト7】BLT (Less Than) : 分岐しないはず (1 < 1 は偽)
-- ==================================================
0017 : 9901; -- CMPI R1, 1  (R1 == 1 なので S^V=0)
0018 : 0000; -- NOP         (★条件1: CMPIの後)
0019 : B916; -- BLT +22     (誤って成立したら ERROR(0030) へ飛ぶ)

-- ==================================================
-- 【テスト8】BLE (Less or Equal) : 分岐するはず (0 <= 1)
-- ==================================================
001A : 9801; -- CMPI R0, 1  (R0 < 1 なので分岐条件成立)
001B : 0000; -- NOP         (★条件1: CMPIの後)
001C : BA01; -- BLE +1      (成立して 001E へ飛ぶ)
001D : A012; -- B +18       (※誤ってここを実行したら ERROR(0030) へ)

-- ==================================================
-- 【テスト9】BLE (Less or Equal) : 分岐するはず (1 <= 1)
-- ==================================================
001E : 9901; -- CMPI R1, 1  (R1 == 1 なので分岐条件成立)
001F : 0000; -- NOP         (★条件1: CMPIの後)
0020 : BA01; -- BLE +1      (成立して 0022 へ飛ぶ)
0021 : A00E; -- B +14       (※誤ってここを実行したら ERROR(0030) へ)

-- ==================================================
-- 【テスト10】BLE (Less or Equal) : 分岐しないはず (1 <= 0 は偽)
-- ==================================================
0022 : 9900; -- CMPI R1, 0  (1 > 0 なので分岐条件不成立)
0023 : 0000; -- NOP         (★条件1: CMPIの後)
0024 : BA0B; -- BLE +11     (誤って成立したら ERROR(0030) へ飛ぶ)

-- ==================================================
-- 【テスト11】無条件分岐 (B)
-- ==================================================
0025 : A001; -- B +1        (無条件で 0027 へ飛ぶ)
0026 : A009; -- B +9        (※誤ってここを実行したら ERROR(0030) へ)

-- ==================================================
-- 【成功パス】全テスト通過
-- ==================================================
0027 : 8700; -- LI R7, 0    (R7 = 0000 : 成功の証)
0028 : A0FF; -- B -1        (無限ループで停止 ※機械語を正しい B命令のA0 に修正)

[0029..002F] : 0000;

-- ==================================================
-- 【失敗パス】意図しない挙動の検知
-- ==================================================
0030 : BEFF; -- LUI R7, 0xFF(R7 = FFFF : 失敗の証 ※機械語を正しいLUI R7 の BE に修正)
0031 : 0000; -- NOP         (★条件3: LUIの後)
0032 : A0FF; -- B -1        (無限ループで停止)

[0033..0FFF] : 0000;
END;