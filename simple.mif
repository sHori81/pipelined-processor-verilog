DEPTH = 16384;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN
-- 命令セット領域 (0〜10番地)

0000 : 8640;    -- LI R6, 64   (OR用のマスク値)
0001 : 8708;    -- LI R7, 8    (比較用の閾値)
0002 : C4C0;    -- IN R4       (外部入力を1回だけ読み込む)
0003 : FC50;    -- CMP R4, R7  (8と比較)
0004 : BA02;    -- BLE 2       (8以下ならアドレス0007へ分岐)
0005 : C4A1;    -- SRL R4, 1   (8より大きい場合: 右論理シフト)
0006 : A001;    -- B 1         (アドレス0008へ無条件分岐)
0007 : C491;    -- SLR R4, 1   (8以下の場合: 左循環シフト)
0008 : F430;    -- OR R4, R6   (R6と論理和をとる)
0009 : E0D0;    -- OUT R4      (結果を1回だけ出力)
000A : C0F0;    -- HLT         (プロセッサ停止)

-- 11番地(000B) 〜 16383番地(3FFF)までは 0
[000B..3FFF] : 0000;
END;
