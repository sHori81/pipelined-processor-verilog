DEPTH = 16384;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- 【初期化】
0000 : 8000; -- LI R0, 0
0001 : 8101; -- LI R1, 1        (判定用マスク)

-- 【アウター・ループ（16周）】
0002 : 9900; -- CMPI R1, 0      (符号ビット周回か判定)
0003 : B204; -- LUI R2, 0x04    (★NOP代わり。フラグを壊さず R2 = 0x0400 準備)
0004 : B902; -- BLT +2          (0x8000なら IS_SIGN(0007) へ)
0005 : 8700; -- LI R7, 0        (R7 = 0: 通常ビット)
0006 : A001; -- B +1            (INIT_PTR(0008) へ)
0007 : 8701; -- LI R7, 1        (R7 = 1: 符号ビット)

-- (ポインタ初期化: 1024個用のアドレスへ変更)
0008 : B308; -- LUI R3, 0x08    (R3 = head0 = 0x0800)
0009 : B40C; -- LUI R4, 0x0C    (R4 = head1 = 0x0C00)
000A : 2A00; -- LD R5, 0(R2)    (★ループ初回用の先読みロード)

-- 【インナー・ループ：配列の振り分け】
000B : 8A01; -- ADDI R2, 1      (★ロード直後のNOP代わり。R2を先に進める)
000C : EE60; -- MOV R6, R5
000D : CE20; -- AND R6, R1
000E : 9E00; -- CMPI R6, 0      
000F : B608; -- LUI R6, 0x08    (★CMP直後のNOP代わり。SZCVフラグを維持したまま終了境界アドレス準備)
0010 : BB04; -- BNE +4          (1なら IS_ONE(0015) へ)

-- (IS_ZERO)
0011 : 9F00; -- CMPI R7, 0      (符号ビット周期か？)
0012 : 0000; -- NOP             (★条件1: CMPIの後)
0013 : B804; -- BE +4           (通常なら PUT_HEAD0(0018) へ)
0014 : A006; -- B +6            (符号なら反転して PUT_HEAD1(001B) へ)

-- (IS_ONE)
0015 : 9F01; -- CMPI R7, 1      (符号ビット周期か？)
0016 : 0000; -- NOP             (★条件1: CMPIの後)
0017 : BB03; -- BNE +3          (通常なら PUT_HEAD1(001B) へ。符号ならPUT_HEAD0(0018)へ)

-- (PUT_HEAD0)
0018 : 6B00; -- ST R5, 0(R3)
0019 : 8B01; -- ADDI R3, 1
001A : A002; -- B +2            (NEXT_ELEM(001D) へ)

-- (PUT_HEAD1)
001B : 6C00; -- ST R5, 0(R4)
001C : 8C01; -- ADDI R4, 1

-- (NEXT_ELEM: 1024個の終了判定)
001D : F250; -- CMP R2, R6      (i == 0x0800 に達したか？)
001E : 2A00; -- LD R5, 0(R2)    (★CMP直後のNOP代わり＆次ループの先読みロード！)
001F : BBEB; -- BNE -21         (終わってなければ インナーループ先頭 000B へ戻る ※オフセット再計算済)

-- 【配列の書き戻しフェーズ】
0020 : B204; -- LUI R2, 0x04    (R2 = dst = 0x0400)
0021 : B608; -- LUI R6, 0x08    (R6 = src0 = 0x0800)

-- (0バッファの書き戻し)
0022 : DE50; -- CMP R6, R3      (R3: 0バッファの終わり)
0023 : 2E00; -- LD R5, 0(R6)    (★CMP直後のNOP代わり＆ロード前倒し)
0024 : B804; -- BE +4           (達したら COPY1_INIT(0029) へ)
0025 : 6A00; -- ST R5, 0(R2)
0026 : 8E01; -- ADDI R6, 1
0027 : 8A01; -- ADDI R2, 1
0028 : A0F9; -- B -7            (0022 へ戻る)

-- (1バッファの書き戻し)
0029 : B60C; -- LUI R6, 0x0C    (R6 = src1 = 0x0C00)
002A : E650; -- CMP R6, R4      (R4: 1バッファの終わり)
002B : 2E00; -- LD R5, 0(R6)    (★CMP直後のNOP代わり＆ロード前倒し)
002C : B804; -- BE +4           (達したら END_OUTER(0031) へ)
002D : 6A00; -- ST R5, 0(R2)
002E : 8E01; -- ADDI R6, 1
002F : 8A01; -- ADDI R2, 1
0030 : A0F9; -- B -7            (002A へ戻る)

-- 【アウター・ループ終了判定】
0031 : C181; -- SLL R1, 1
0032 : 9900; -- CMPI R1, 0      (16ビット回ったか？)
0033 : 0000; -- NOP             (★条件1: CMPIの後)
0034 : BBCD; -- BNE -51         (終わってなければ アウター先頭 0002 へ戻る ※オフセット再計算済：BBCD)

-- 完了停止
0035 : C0F0; -- HLT             (ソート完了、ハードウェアカウンタ停止)

[0036..3FFF] : 0000;
END;
