DEPTH = 4096;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- ==========================================
-- 初期化フェーズ
-- ==========================================
0000 : 8E01; -- LUI R1, 1       (R1 = 0x0100: バケツのベースアドレス)
0001 : CA60; -- MOV R2, R1      (R2 = 0x0100: 初期化用ポインタ)
0002 : 9E02; -- LUI R3, 2       (R3 = 0x0200: 初期化終了アドレス)
0003 : 8000; -- LI R0, 0        (R0 = 0)

-- ==========================================
-- Pass 1: 下位8ビットのソート (配列A:0x0400 -> 配列B:0x0800)
-- ==========================================
-- ① バケツの初期化 (0x0100 〜 0x01FF を 0クリア)
0004 : 4200; -- ST R0, 0(R2)
0005 : 9101; -- ADDI R2, 1
0006 : DA50; -- CMP R2, R3
0007 : 0000; -- NOP
0008 : BBFC; -- BNE -4          (0004へ戻る)

-- ② ヒストグラム作成 (1024個)
0009 : 9604; -- LUI R2, 4       (R2 = src_ptr = 0x0400)
000A : 9E08; -- LUI R3, 8       (R3 = src_end = 0x0800)
000B : B0FF; -- LI R6, 255      (R6 = 0x00FF: マスク)
000C : 2A00; -- LD R5, 0(R2)
000D : 0000; -- NOP
000E : EC60; -- MOV R4, R5      (R4 = データ退避)
000F : F420; -- AND R4, R6      (R4 = 下位8ビット)
0010 : CC00; -- ADD R4, R1      (R4 = バケツアドレス: 0x0100 + 値)
0011 : 0400; -- LD R0, 0(R4)    (カウント読み込み)
0012 : 0000; -- NOP
0013 : 8101; -- ADDI R0, 1      (カウント+1)
0014 : 4400; -- ST R0, 0(R4)    (カウント保存)
0015 : 9101; -- ADDI R2, 1
0016 : DA50; -- CMP R2, R3
0017 : 0000; -- NOP
0018 : BBF4; -- BNE -12         (000Cへ戻る)

-- ③ ポインタ累積和計算
0019 : B608; -- LUI R6, 8       (R6 = 書き込み先ベース = 0x0800)
001A : CA60; -- MOV R2, R1      (R2 = バケツ先頭 = 0x0100)
001B : 9E02; -- LUI R3, 2       (R3 = バケツ終端 = 0x0200)
001C : 0200; -- LD R0, 0(R2)
001D : 0000; -- NOP
001E : 7200; -- ST R6, 0(R2)    (累積アドレスを書き込む)
001F : C600; -- ADD R6, R0      (次のアドレスを計算)
0020 : 9101; -- ADDI R2, 1
0021 : DA50; -- CMP R2, R3
0022 : 0000; -- NOP
0023 : BBF9; -- BNE -7          (001Cへ戻る)

-- ④ データの振り分け
0024 : 9604; -- LUI R2, 4       (R2 = src_ptr = 0x0400)
0025 : 9E08; -- LUI R3, 8       (R3 = src_end = 0x0800)
0026 : B0FF; -- LI R6, 255      (R6 = 0x00FF: マスク)
0027 : 2A00; -- LD R5, 0(R2)
0028 : 0000; -- NOP
0029 : EC60; -- MOV R4, R5
002A : F420; -- AND R4, R6
002B : CC00; -- ADD R4, R1      (R4 = バケツアドレス)
002C : 0400; -- LD R0, 0(R4)    (書き込み先ポインタ取得)
002D : 0000; -- NOP
002E : 6800; -- ST R5, 0(R0)    (配列Bへ書き込み)
002F : 8101; -- ADDI R0, 1      (ポインタ進める)
0030 : 4400; -- ST R0, 0(R4)    (ポインタ保存)
0031 : 9101; -- ADDI R2, 1
0032 : DA50; -- CMP R2, R3
0033 : 0000; -- NOP
0034 : BBF3; -- BNE -13         (0027へ戻る)


-- ==========================================
-- Pass 2: 上位8ビットのソート (配列B:0x0800 -> 配列A:0x0400)
-- ==========================================
-- ① バケツの初期化
0035 : CA60; -- MOV R2, R1      (R2 = 0x0100)
0036 : 9E02; -- LUI R3, 2       (R3 = 0x0200)
0037 : 8000; -- LI R0, 0
0038 : 4200; -- ST R0, 0(R2)
0039 : 9101; -- ADDI R2, 1
003A : DA50; -- CMP R2, R3
003B : 0000; -- NOP
003C : BBFC; -- BNE -4          (0038へ戻る)

-- ② ヒストグラム作成
003D : 9608; -- LUI R2, 8       (R2 = src_ptr = 0x0800)
003E : 9E0C; -- LUI R3, 12      (R3 = src_end = 0x0C00)
003F : 2A00; -- LD R5, 0(R2)
0040 : 0000; -- NOP
0041 : EC60; -- MOV R4, R5
0042 : C4A8; -- SRL R4, 8       (上位8ビット抽出)
0043 : CC00; -- ADD R4, R1      (バケツアドレス計算)
0044 : 0400; -- LD R0, 0(R4)
0045 : 0000; -- NOP
0046 : 8101; -- ADDI R0, 1
0047 : 4400; -- ST R0, 0(R4)
0048 : 9101; -- ADDI R2, 1
0049 : DA50; -- CMP R2, R3
004A : 0000; -- NOP
004B : BBF4; -- BNE -12         (003Fへ戻る)

-- ③ ポインタ累積和計算 (マイナス値 0x80〜0xFF を先に処理)
004C : B604; -- LUI R6, 4       (R6 = 最終書き込み先 = 0x0400)
004D : 8080; -- LI R0, 128      (R0 = 0x0080)
004E : CA60; -- MOV R2, R1      (R2 = 0x0100)
004F : C200; -- ADD R2, R0      (R2 = 0x0180: マイナス領域開始)
0050 : 9E02; -- LUI R3, 2       (R3 = 0x0200: マイナス領域終了)
0051 : 2A00; -- LD R5, 0(R2)    (カウントをR5へ)
0052 : 0000; -- NOP
0053 : 7200; -- ST R6, 0(R2)
0054 : EE00; -- ADD R6, R5      (R6 += カウント)
0055 : 9101; -- ADDI R2, 1
0056 : DA50; -- CMP R2, R3
0057 : 0000; -- NOP
0058 : BBF9; -- BNE -7          (0051へ戻る)

-- (プラス値 0x00〜0x7F の処理)
0059 : CA60; -- MOV R2, R1      (R2 = 0x0100: プラス領域開始)
005A : CB60; -- MOV R3, R1
005B : C300; -- ADD R3, R0      (R3 = 0x0180: プラス領域終了)
005C : 2A00; -- LD R5, 0(R2)
005D : 0000; -- NOP
005E : 7200; -- ST R6, 0(R2)
005F : EE00; -- ADD R6, R5
0060 : 9101; -- ADDI R2, 1
0061 : DA50; -- CMP R2, R3
0062 : 0000; -- NOP
0063 : BBF9; -- BNE -7          (005Cへ戻る)

-- ④ データの振り分け
0064 : 9608; -- LUI R2, 8       (R2 = src_ptr = 0x0800)
0065 : 9E0C; -- LUI R3, 12      (R3 = src_end = 0x0C00)
0066 : 2A00; -- LD R5, 0(R2)
0067 : 0000; -- NOP
0068 : EC60; -- MOV R4, R5
0069 : C4A8; -- SRL R4, 8       (上位8ビット抽出)
006A : CC00; -- ADD R4, R1
006B : 0400; -- LD R0, 0(R4)
006C : 0000; -- NOP
006D : 6800; -- ST R5, 0(R0)    (配列Aに書き戻し完成！)
006E : 8101; -- ADDI R0, 1
006F : 4400; -- ST R0, 0(R4)
0070 : 9101; -- ADDI R2, 1
0071 : DA50; -- CMP R2, R3
0072 : 0000; -- NOP
0073 : BBF3; -- BNE -13         (0066へ戻る)

-- 完了停止
0074 : C0F0; -- HLT

[0075..0FFF] : 0000;
END;