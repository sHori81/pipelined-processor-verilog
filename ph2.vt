`timescale 1 ps/ 1 ps
module ph2_vlg_tst();
// constants                                           
// general purpose registers
reg eachvec;
// test vector input registers
reg clk;
reg [15:0] ir_input;
reg load;
reg rst;
// wires                                               
wire [2:0]  cond;
wire [15:0]  data_a;
wire [15:0]  data_b;
wire [3:0]  dif4;
wire [7:0]  dif8;
wire [1:0]  op1;
wire [2:0]  op2;
wire [3:0]  op3;

// assign statements (if any)                          
ph2 i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.cond(cond),
	.data_a(data_a),
	.data_b(data_b),
	.dif4(dif4),
	.dif8(dif8),
	.ir_input(ir_input),
	.load(load),
	.op1(op1),
	.op2(op2),
	.op3(op3),
	.rst(rst)
);
initial                                                
begin                                                  
// code that executes only once                        
// insert code here --> begin                          
	clk <= 0;
	rst <= 0;
	load <= 0;
	ir_input <= 16'd0;                
// --> end                                             
$display("Running testbench");                       
end                                                    
always                                                 
// optional sensitivity list                           
// @(event1 or event2 or .... eventn)                  
begin                                                  
// code executes for every event on sensitivity list   
// insert code here --> begin                          
#10 
rst <= 1;
load <= 1;
#50
ir_input <= 16'b00_000_001_0000_0000;
#50
ir_input <= 16'b01_010_011_0101_0101;
#50
ir_input <= 16'b10_100_101_1010_1010;
#50
ir_input <= 16'b11_110_111_1111_1111;
#50
load <= 0;
#50
ir_input <= 16'b00_000_001_0000_0000;



//@eachvec;                                              
// --> end                                             
end

always begin
#10
	clk = ~clk;
end
endmodule

