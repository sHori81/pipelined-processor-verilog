DEPTH = 4096;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT BEGIN
-- ==================================================
-- 【プログラム本体】 (IMEM 0000番地スタート)
-- ==================================================
0000 : 8000; -- LI R0, 0    (R0 = 合計値 = 0)
0001 : 8100; -- LI R1, 0    (R1 = アドレスポインタ = 0)

-- 【ループ先頭】(0002番地)
0002 : 1100; -- LD R2, 0(R1)(R2 = DMEM[R1] を読み込み)
0003 : 0000; -- NOP         (★データハザード: LD直後のR2利用待ち)
0004 : D600; -- ADD R0, R2  (合計値 R0 に R2 を足す)
0005 : 8901; -- ADDI R1, 1  (アドレスポインタ R1 を 1 進める)
0006 : 0000; -- NOP         (★データハザード: ADDI直後のR1利用待ち)
0007 : 9908; -- CMPI R1, 8  (ポインタが 8 に到達したか判定)
0008 : 0000; -- NOP         (★データハザード: CMPI直後の分岐条件確定待ち)
0009 : BBF8; -- BNE -8      (8未満なら ループ先頭 0002 へ飛ぶ ※オフセット d=-8)

-- 【完了停止】
000E : B7FF; -- LUI R7, 0xFF (完了サインとしてR7をFFFFに)
000F : A7FF; -- B -1         (無限ループで停止 ※オフセット d=-1)
0010 : 0000; -- NOP         (★制御ハザード: 分岐遅延スロット)
0011 : 0000; -- NOP         
0012 : 0000; -- NOP         
0013 : 0000; -- NOP         

[0014..0FFF] : 0000;
END;